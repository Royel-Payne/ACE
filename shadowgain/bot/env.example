# Shadowgain bot configuration.
#
# Deployed to /opt/ACE/bot.env on the droplet, mode 600, owned by root.
# NEVER commit the filled-in version - it holds two secrets.

# --- Discord -------------------------------------------------------------------------
# From discord.com/developers/applications -> your app -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Server and channel IDs. Not secrets, but left blank here - the live values belong
# only in /opt/ACE/bot.env, which is never committed.
DISCORD_GUILD_ID=
DISCORD_RELAY_CHANNEL_ID=
DISCORD_BUGS_CHANNEL_ID=

# 045: read-only #audit. Every privileged command lands here. Exempt from the retention
# purge below, which only ever touches the relay channel.
DISCORD_AUDIT_CHANNEL_ID=

# The gold role. Granted once, never revoked - it is an achievement, not a status that
# can lapse. See account_is_ascendant() for the four conditions.
DISCORD_ASCENDANT_ROLE_ID=

# Created manually in Discord - see README.md. The bot's own role must sit ABOVE this
# one in Server Settings -> Roles, or it cannot grant it.
DISCORD_VERIFIED_ROLE_ID=

# --- Database (read-only user, created by setup.sql) ----------------------------------
SG_DB_HOST=127.0.0.1
SG_DB_PORT=3306
SG_DB_USER=sgbot
SG_DB_PASSWORD=

# The shard database. Must be set: the account/character queries name tables without
# qualifying them, so an empty default database fails every lookup with
# "(1046, 'No database selected')" - which surfaces as /verify silently never working.
SG_DB_NAME=ace_shard

# --- Paths ----------------------------------------------------------------------------
# The bot's view of the shared log directory. The server sees the same files as
# /ace/Logs/ inside its container.
SG_LOG_DIR=/opt/ACE/Logs
SG_STATE_PATH=/opt/ACE/bot-state.json

# Discord -> game queue. The bot appends here; ShadowgainInbound tails it on the world
# thread. Must match the server's compiled InboundPath (/ace/Logs/inbound.jsonl) through
# the bind mount.
SG_INBOUND_PATH=/opt/ACE/Logs/inbound.jsonl

# --- Gating rules ---------------------------------------------------------------------
SG_MIN_LEVEL=10
SG_ACTIVITY_HOURS=72
SG_SWEEP_HOURS=24
SG_CODE_TTL_SECONDS=900

# Gold role: level ceiling, hard lane, non-staff account, and real playtime behind it.
# The hours floor is a sanity check against boosted characters, not a gate - a genuine
# climb is hundreds of hours, so it can never fail a real player.
SG_ASCENDANT_LEVEL=275
SG_ASCENDANT_MIN_HOURS=100
SG_BATCH_SECONDS=2.0

# Rolling retention on the RELAY channel only (#bugs and #audit keep their history on
# purpose). Messages older than this are deleted hourly. 0 disables.
SG_CHAT_RETENTION_HOURS=24

# SERVER MEMBERS privileged intent. Portal toggle FIRST, then this - discord.py refuses to
# connect if the bot requests an intent the application has not been granted, and under
# Restart=always that is a crash loop. Not required for normal operation (resolve_member
# falls back to a single REST fetch); it buys a populated member cache for the daily sweep
# and makes bulk role-holder audits possible.
SG_MEMBERS_INTENT=1

# Read the relay channel directly, so a verified user just types to speak in game.
# Requires the MESSAGE CONTENT intent in the developer portal - without it the bot
# receives empty message content and inbound chat silently does nothing.
SG_READ_CHANNEL=1
