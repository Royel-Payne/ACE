<?xml version="1.0"?>
<!--
  Shadowgain Admin Console - 540 x 400, the size Design proposed.

  LAYOUT NOTE: everything hangs off a single FixedLayout, and the roster panel is a SIBLING of
  the Notebook rather than a page inside it. That is the arrangement 054's spike confirmed by
  reading a shipping plugin's own view (GoArrow), and it is what makes the roster persistent
  across tab changes. VVS has no flow or anchoring, so every control carries absolute
  left/top/width/height.

  ROSTER SIDE: right of the tabs, per the mock's stated default.

  COLUMN WIDTHS: a <column> carries fixedwidth, NOT width - confirmed by reading the view
  embedded in MagTools.dll rather than by guessing.

  NO HIDDEN COLUMNS. An earlier revision gave each list an extra fixedwidth-less column to carry
  the exact string to send, on the reading that MagTools' width-less columns (ManaItemID,
  ManaItemSort) are hidden data columns. That reading was inferred, never proven, and it went in
  during the same build that started closing the client on world entry. The backing List<> objects
  in PluginCore already hold every value a command needs, so the columns bought nothing and were
  removed rather than left as a suspect. Do not reintroduce them without testing that VVS really
  tolerates a write to a column it gave no width.

  TAB LABELS are padded with spaces. MetaView sizes a tab to its label, so unpadded labels
  produce cramped tabs - MagTools pads every one of its own.

  TIER NOTE: all five pages are declared here and ALL FIVE ARE DRAWN, for everyone. The brief
  calls for tabs a tier cannot use to be absent, but INotebook has no remove-page method and
  MVWireupHelper.WireupStart takes no raw-XML overload - see PluginCore's class comment. The
  server refuses anything the account's AccessLevel lacks, so this is cosmetic, not a hole.

  ASCII ONLY. The server speaks CP1252 on the chat path and this file is compiled without a
  BOM; a stray em-dash here is one more place for an encoding surprise to hide.
-->
<view icon="8129" title="Shadowgain Console" width="540" height="400">
  <control progid="DecalControls.FixedLayout" clipped="">

    <!-- ================= persistent status strip (all tiers) ================= -->
    <control progid="DecalControls.StaticText" name="lblStatus"  left="4"   top="4"  width="430" height="16" text="Shadowgain - status pending" />
    <control progid="DecalControls.PushButton" name="btnRefresh" left="440" top="2"  width="94"  height="20" text="Refresh" />

    <!-- ================= tabs ================================================ -->
    <control progid="DecalControls.Notebook" name="nbMain" left="4" top="26" width="348" height="320">

      <page label="  Players  ">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblTarget"   left="6"   top="4"  width="320" height="16" text="Target: (none selected)" />

          <control progid="DecalControls.PushButton" name="btnGoTo"     left="6"   top="26" width="74"  height="22" text="Go to" />
          <control progid="DecalControls.PushButton" name="btnSummon"   left="84"  top="26" width="74"  height="22" text="Summon" />
          <control progid="DecalControls.PushButton" name="btnSendBack" left="162" top="26" width="84"  height="22" text="Send back" />
          <control progid="DecalControls.PushButton" name="btnGag"      left="250" top="26" width="60"  height="22" text="Gag" />

          <!-- arm -> confirm: btnKickNo is hidden until btnKick is armed -->
          <control progid="DecalControls.PushButton" name="btnKick"     left="6"   top="54" width="84"  height="22" text="Kick" />
          <control progid="DecalControls.PushButton" name="btnKickNo"   left="94"  top="54" width="60"  height="22" text="Cancel" />

          <!-- Self-action, deliberately set apart from the target verbs above it. Duplicates the
               Me tab's button because the natural moment to want it is straight after Go to. -->
          <control progid="DecalControls.PushButton" name="btnReturnMe" left="236" top="54" width="90"  height="22" text="Return me" />

          <control progid="DecalControls.StaticText" name="lblPlayers"  left="6"   top="82" width="320" height="16" text="Select a player from the roster." />
        </control>
      </page>

      <page label="  Me  ">
        <control progid="DecalControls.FixedLayout" clipped="">
          <!-- a toggle BUTTON carrying its own state in the caption, per the mock - not a checkbox -->
          <control progid="DecalControls.PushButton" name="btnAttack"   left="6"   top="4"  width="124" height="22" text="Attackable: ?" />
          <control progid="DecalControls.PushButton" name="btnReturn"   left="136" top="4"  width="90"  height="22" text="Return me" />

          <control progid="DecalControls.StaticText" name="lblPoiHead"  left="6"   top="32" width="320" height="16" text="Destination - type to filter" />
          <control progid="DecalControls.Edit"       name="txtPoiFilter" left="6"  top="52" width="220" height="20" text="" />

          <control progid="DecalControls.List"       name="lstPoi"      left="6"   top="76" width="320" height="140">
            <column progid="DecalControls.TextColumn" name="colPoiName"  fixedwidth="196" />
            <column progid="DecalControls.TextColumn" name="colPoiCoord" fixedwidth="112" />
          </control>

          <control progid="DecalControls.PushButton" name="btnPoiGo"    left="6"   top="222" width="70"  height="22" text="Tele" />
          <control progid="DecalControls.StaticText" name="lblPoi"      left="82"  top="225" width="244" height="16" text="Pick a destination." />

          <control progid="DecalControls.Edit"       name="txtCoord"    left="6"   top="250" width="180" height="20" text="" />
          <control progid="DecalControls.PushButton" name="btnCoordGo"  left="192" top="249" width="100" height="22" text="Tele coords" />
        </control>
      </page>

      <page label="  Server  ">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblSrv1"     left="6"   top="4"  width="320" height="16" text="server - not yet polled" />
          <control progid="DecalControls.StaticText" name="lblSrv2"     left="6"   top="22" width="320" height="16" text="" />
          <control progid="DecalControls.StaticText" name="lblSrv3"     left="6"   top="40" width="320" height="16" text="" />

          <!-- SHUTDOWN REMOVED (075). ACE's shutdown closes the world, drops every session and
               then does not reliably exit - it stranded this server for seven minutes, refusing
               logins from a real address, with the container still reporting healthy. Docker's
               restart policy never fires because the process never dies.

               There is no restart command in ACE to offer instead, and a plugin inside the game
               client cannot restart a container. deploy.sh is the safe path and swaps the
               container itself rather than trusting ACE to exit. A button whose only outcomes are
               "nothing" or "server down until someone SSHes in" does not belong on a moderation
               panel. -->

          <control progid="DecalControls.StaticText" name="lblStormHead" left="6"  top="70" width="320" height="16" text="Portal Storm - clears the landblock you are standing in" />
          <control progid="DecalControls.PushButton" name="btnStorm"    left="6"   top="90" width="110" height="22" text="Portal Storm" />
          <control progid="DecalControls.PushButton" name="btnStormNo"  left="120" top="90" width="60"  height="22" text="Cancel" />

          <control progid="DecalControls.StaticText" name="lblServer"   left="6"   top="118" width="320" height="16" text="Players are sent to their lifestones. You are never stormed." />
        </control>
      </page>

      <page label="  Access  ">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblCapHead"  left="6"   top="4"  width="320" height="16" text="Global multibox cap" />
          <control progid="DecalControls.Edit"       name="txtCap"      left="6"   top="24" width="50"  height="20" text="" />
          <control progid="DecalControls.PushButton" name="btnCapSet"   left="62"  top="23" width="56"  height="22" text="Set" />
          <control progid="DecalControls.StaticText" name="lblCapHint"  left="6"   top="48" width="320" height="16" text="-1 = unlimited" />

          <control progid="DecalControls.StaticText" name="lblOvHead"   left="6"   top="70" width="320" height="16" text="Per-character overrides" />
          <control progid="DecalControls.List"       name="lstMb"       left="6"   top="90" width="320" height="100">
            <column progid="DecalControls.TextColumn" name="colMbWho" fixedwidth="204" />
            <column progid="DecalControls.TextColumn" name="colMbN"   fixedwidth="104" />
          </control>

          <control progid="DecalControls.StaticText" name="lblMbName"   left="6"   top="198" width="40"  height="16" text="Name:" />
          <control progid="DecalControls.Edit"       name="txtMbName"   left="48"  top="196" width="120" height="20" text="" />
          <control progid="DecalControls.StaticText" name="lblMbN"      left="174" top="198" width="16"  height="16" text="N:" />
          <control progid="DecalControls.Edit"       name="txtMbN"      left="192" top="196" width="40"  height="20" text="-1" />

          <control progid="DecalControls.PushButton" name="btnMbAdd"    left="6"   top="222" width="64"  height="22" text="Add" />
          <control progid="DecalControls.PushButton" name="btnMbRemove" left="74"  top="222" width="116" height="22" text="Remove selected" />
          <control progid="DecalControls.PushButton" name="btnMbShow"   left="194" top="222" width="74"  height="22" text="Refresh" />

          <control progid="DecalControls.StaticText" name="lblAccess"   left="6"   top="250" width="320" height="16" text="Selecting a roster row fills the name." />
        </control>
      </page>

      <page label="  Oversight  ">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblOvHead2"  left="6"   top="4"  width="320" height="16" text="Dial history - every change, including console and staff" />

          <control progid="DecalControls.StaticText" name="lblDialName" left="6"   top="26" width="32"  height="16" text="Dial:" />
          <control progid="DecalControls.Edit"       name="txtDial"     left="40"  top="24" width="180" height="20" text="" />
          <control progid="DecalControls.PushButton" name="btnDialHist" left="226" top="23" width="96"  height="22" text="History" />

          <control progid="DecalControls.List"       name="lstHist"     left="6"   top="50" width="320" height="170">
            <column progid="DecalControls.TextColumn" name="colHT"     fixedwidth="72" />
            <column progid="DecalControls.TextColumn" name="colHD"     fixedwidth="96" />
            <column progid="DecalControls.TextColumn" name="colHDelta" fixedwidth="80" />
            <column progid="DecalControls.TextColumn" name="colHWho"   fixedwidth="60" />
          </control>

          <control progid="DecalControls.PushButton" name="btnRevert"   left="6"   top="228" width="116" height="22" text="Revert selected" />
          <control progid="DecalControls.PushButton" name="btnRevertNo" left="126" top="228" width="60"  height="22" text="Cancel" />

          <control progid="DecalControls.StaticText" name="lblOversight" left="6"  top="256" width="320" height="16" text="Revert restores the previous recorded value." />
        </control>
      </page>

    </control>

    <!-- ================= roster side panel (all tiers) ======================= -->
    <control progid="DecalControls.StaticText" name="lblRoster"  left="358" top="26" width="178" height="16" text="Online - 0" />
    <control progid="DecalControls.List"       name="lstRoster"  left="358" top="44" width="178" height="302">
      <column progid="DecalControls.TextColumn" name="colName" fixedwidth="166" />
    </control>

    <!-- ================= command echo strip ================================== -->
    <control progid="DecalControls.StaticText" name="lblEcho" left="4" top="352" width="532" height="16" text="" />

  </control>
</view>
