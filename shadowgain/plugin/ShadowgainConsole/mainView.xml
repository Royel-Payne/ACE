<?xml version="1.0"?>
<!--
  Shadowgain Admin Console - 540 x 400, the size Design proposed.

  LAYOUT NOTE: everything hangs off a single FixedLayout, and the roster panel is a SIBLING of
  the Notebook rather than a page inside it. That is the arrangement 054's spike confirmed by
  reading a shipping plugin's own view (GoArrow), and it is what makes the roster persistent
  across tab changes. VVS has no flow or anchoring, so every control carries absolute
  left/top/width/height.

  TIER NOTE: all five pages are declared here. The plugin REMOVES the ones the logged-in
  character's AccessLevel does not permit, because the brief calls for absent rather than
  greyed-out. Declaring them all keeps the XML static and the gating in one place.
-->
<view icon="8129" title="Shadowgain Console" width="540" height="400">
  <control progid="DecalControls.FixedLayout" clipped="">

    <!-- ================= persistent status strip (all tiers) ================= -->
    <control progid="DecalControls.StaticText" name="lblStatus"  left="4"   top="4"  width="440" height="16" text="Shadowgain - status pending" />
    <control progid="DecalControls.PushButton" name="btnRefresh" left="448" top="2"  width="86"  height="20" text="Refresh" />

    <!-- ================= roster side panel (all tiers) ======================= -->
    <control progid="DecalControls.StaticText" name="lblRoster"  left="4"   top="26" width="176" height="16" text="Online - 0" />
    <control progid="DecalControls.List"       name="lstRoster"  left="4"   top="44" width="176" height="330">
      <column progid="DecalControls.TextColumn" name="colName" />
    </control>

    <!-- ================= tabs, beside the panel ============================== -->
    <control progid="DecalControls.Notebook" name="nbMain" left="186" top="26" width="350" height="348">

      <page label="Players">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblTarget"   left="6"  top="6"   width="330" height="16" text="Target: (none selected)" />

          <control progid="DecalControls.PushButton" name="btnGoTo"     left="6"  top="30"  width="100" height="22" text="Go to" />
          <control progid="DecalControls.PushButton" name="btnSummon"   left="112" top="30" width="100" height="22" text="Summon" />
          <control progid="DecalControls.PushButton" name="btnSendBack" left="218" top="30" width="110" height="22" text="Send back" />

          <control progid="DecalControls.PushButton" name="btnGag"      left="6"  top="60"  width="100" height="22" text="Gag" />
          <control progid="DecalControls.PushButton" name="btnKick"     left="112" top="60" width="100" height="22" text="Kick" />
          <control progid="DecalControls.PushButton" name="btnKickNo"   left="218" top="60" width="110" height="22" text="Cancel" />

          <control progid="DecalControls.StaticText" name="lblPlayers"  left="6"  top="92"  width="330" height="16" text="Select a player from the roster." />
        </control>
      </page>

      <page label="Me">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.CheckBox"   name="chkAttackable" left="6" top="6"  width="150" height="20" text="Attackable" />

          <control progid="DecalControls.StaticText" name="lblPoi"      left="6"  top="34"  width="60"  height="16" text="Go to:" />
          <control progid="DecalControls.Combo"      name="cmbPoi"      left="66" top="32"  width="180" height="20" />
          <control progid="DecalControls.PushButton" name="btnPoiGo"    left="252" top="31" width="80"  height="22" text="Travel" />

          <control progid="DecalControls.StaticText" name="lblCoord"    left="6"  top="64"  width="60"  height="16" text="Coords:" />
          <control progid="DecalControls.Edit"       name="txtCoord"    left="66" top="62"  width="180" height="20" text="" />
          <control progid="DecalControls.PushButton" name="btnCoordGo"  left="252" top="61" width="80"  height="22" text="Tele" />

          <control progid="DecalControls.StaticText" name="lblMe"       left="6"  top="94"  width="330" height="16" text="Coordinates look like 33.2N,56.5E" />
        </control>
      </page>

      <page label="Server">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblSrvHead"  left="6"  top="6"   width="330" height="16" text="Server operations" />

          <control progid="DecalControls.StaticText" name="lblStormLb"  left="6"  top="32"  width="80"  height="16" text="Landblock:" />
          <control progid="DecalControls.Edit"       name="txtStormLb"  left="86" top="30"  width="90"  height="20" text="" />
          <control progid="DecalControls.PushButton" name="btnStorm"    left="182" top="29" width="100" height="22" text="Portal Storm" />
          <control progid="DecalControls.PushButton" name="btnStormNo"  left="286" top="29" width="50"  height="22" text="No" />

          <control progid="DecalControls.StaticText" name="lblShutInt"  left="6"  top="62"  width="80"  height="16" text="Countdown:" />
          <control progid="DecalControls.Edit"       name="txtShutInt"  left="86" top="60"  width="90"  height="20" text="60" />
          <control progid="DecalControls.PushButton" name="btnShutdown" left="182" top="59" width="100" height="22" text="Shutdown" />
          <control progid="DecalControls.PushButton" name="btnShutNo"   left="286" top="59" width="50"  height="22" text="No" />

          <control progid="DecalControls.StaticText" name="lblServer"   left="6"  top="92"  width="330" height="16" text="Blank landblock = the one you are standing in." />
        </control>
      </page>

      <page label="Access">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblAccHead"  left="6"  top="6"   width="330" height="16" text="Multibox overrides" />

          <control progid="DecalControls.StaticText" name="lblMbName"   left="6"  top="32"  width="50"  height="16" text="Name:" />
          <control progid="DecalControls.Edit"       name="txtMbName"   left="56" top="30"  width="130" height="20" text="" />
          <control progid="DecalControls.StaticText" name="lblMbN"      left="192" top="32" width="20"  height="16" text="N:" />
          <control progid="DecalControls.Edit"       name="txtMbN"      left="212" top="30" width="40"  height="20" text="-1" />

          <control progid="DecalControls.PushButton" name="btnMbSet"    left="6"  top="58"  width="90"  height="22" text="Set" />
          <control progid="DecalControls.PushButton" name="btnMbRemove" left="102" top="58" width="90"  height="22" text="Remove" />
          <control progid="DecalControls.PushButton" name="btnMbShow"   left="198" top="58" width="90"  height="22" text="Show" />

          <control progid="DecalControls.StaticText" name="lblAccess"   left="6"  top="88"  width="330" height="16" text="N = -1 for unlimited. Roster selection fills the name." />
        </control>
      </page>

      <page label="Oversight">
        <control progid="DecalControls.FixedLayout" clipped="">
          <control progid="DecalControls.StaticText" name="lblOvHead"   left="6"  top="6"   width="330" height="16" text="Dial history" />

          <control progid="DecalControls.StaticText" name="lblDialName" left="6"  top="32"  width="40"  height="16" text="Dial:" />
          <control progid="DecalControls.Edit"       name="txtDial"     left="46" top="30"  width="180" height="20" text="" />
          <control progid="DecalControls.PushButton" name="btnDialHist" left="232" top="29" width="100" height="22" text="History" />

          <control progid="DecalControls.PushButton" name="btnRevert"   left="6"  top="58"  width="100" height="22" text="Revert" />
          <control progid="DecalControls.PushButton" name="btnRevertNo" left="112" top="58" width="50"  height="22" text="No" />

          <control progid="DecalControls.StaticText" name="lblOversight" left="6" top="88"  width="330" height="16" text="Revert restores the previous recorded value." />
        </control>
      </page>

    </control>
  </control>
</view>
