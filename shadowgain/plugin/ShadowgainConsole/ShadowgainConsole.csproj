<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{051CB97E-916F-4863-AE4F-EAD7BA3C08EF}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ShadowgainConsole</RootNamespace>
    <AssemblyName>ShadowgainConsole</AssemblyName>
    <!-- v2.0 and x86 are not preferences: Decal.Adapter is an x86 assembly and the client is a
         32-bit process. Building AnyCPU or a newer framework produces a DLL Decal cannot load. -->
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
    <PlatformTarget>x86</PlatformTarget>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE;VVS_REFERENCED</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Decal.Adapter">
      <HintPath>C:\Games\Decal 3.0\Decal.Adapter.dll</HintPath>
    </Reference>
    <Reference Include="VirindiViewService">
      <HintPath>C:\Games\VirindiPlugins\VirindiViewService\VirindiViewService.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Globals.cs" />
    <Compile Include="PluginCore.cs" />
    <Compile Include="Util.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="VirindiViews\ViewSystemSelector.cs" />
    <Compile Include="VirindiViews\Wrapper.cs" />
    <Compile Include="VirindiViews\Wrapper_Decal.cs" />
    <Compile Include="VirindiViews\Wrapper_MyHuds.cs" />
    <Compile Include="VirindiViews\Wrapper_WireupHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- MUST be an embedded resource. If it is not, the plugin loads but never appears in-game. -->
    <EmbeddedResource Include="mainView.xml" />
    <!-- Title-bar icon. Embedded rather than shipped beside the DLL so it cannot go missing on
         someone else's install - this is handed out as a zip, and poi.tsv already proves a file
         can get separated from its binary. -->
    <EmbeddedResource Include="icon.png" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
